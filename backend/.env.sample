# ==============================================================================
# Urban Loom Backend Environment Configuration
# ==============================================================================

# Server Port (default: 5000)
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/userDB
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/userDB?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/userDB

# Allowed Frontend Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT Authentication Secrets & Expiry
ACCESS_TOKEN_SECRET=urban_loom_access_token_super_secret_key_2026_jwt
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=urban_loom_refresh_token_super_secret_key_2026_jwt
REFRESH_TOKEN_EXPIRY=7d

# ImageKit Configuration (Product Image CDN & Cloud Storage)
# Optional in offline development; required for admin product image upload
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Razorpay Configuration (Online Payments)
# Optional in offline development; COD works without Razorpay keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Nodemailer / SMTP Configuration (Password Reset Emails)
# Optional for basic browsing; required for forgot/reset password flow
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
